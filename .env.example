# =========================================================================
# IZOX — Circular Fleet Care — Variables d'environnement (exemple)
# Copier ce fichier en `.env` et renseigner les valeurs de votre projet.
# =========================================================================

# --- Supabase (frontend, exposé au client via VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (build / SSR) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# =========================================================================
# Secrets côté Supabase Edge Functions (à configurer dans le dashboard
# Supabase → Project Settings → Edge Functions → Secrets, PAS dans ce fichier)
# =========================================================================
# RESEND_API_KEY=        # clé API Resend pour l'envoi d'emails
# EMAIL_FROM=            # ex: IZOX <noreply@votre-domaine.fr>
# SITE_URL=              # URL publique de l'application
